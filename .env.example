# Wix Headless — OAuth app client ID (Wix dashboard > Settings > Headless Settings).
# Used to read public content such as blog posts.
WIX_CLIENT_ID=
WIX_CLIENT_SECRET=

# Wix API key with "Manage Contacts" permission (manage.wix.com/account/api-keys).
# Used by the contact form to create leads in the CRM. Server-only: never prefix with VITE_.
WIX_API_KEY=
# Site ID (the UUID in the dashboard URL: manage.wix.com/dashboard/<site-id>/...)
WIX_SITE_ID=
